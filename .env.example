# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# "mock" (default): deterministic, free, no network calls.
# "api": ask Claude for the table and compare it with the deterministic engine.
BELIEF_ENGINE_MODE=mock

# Only needed when BELIEF_ENGINE_MODE=api. Server-side only: do NOT prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Defaults to the low-cost Haiku model set in src/engine/api-mode.ts.
# ANTHROPIC_MODEL=

# "Make Your Own" page. "demo" (default) recognises only the built-in examples and sends nothing
# anywhere. "ai" reads the user's own description with the model above, so it ALSO needs
# ANTHROPIC_API_KEY. In AI mode the page tells users their text is sent to an outside AI provider.
CUSTOM_SCENARIO_MODE=demo
